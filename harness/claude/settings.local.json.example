{
  "_comment": "Copy to settings.local.json (gitignored) for personal overrides. These take precedence over settings.json.",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "_comment_provider": "AI-DLC ships no model-provider env: Claude Code uses whatever model access you already have. Only set the AWS keys below if you answered 'amazon-bedrock' at `aidlc config`, or want to route through Bedrock by hand.",
    "_comment_AWS_REGION": "Bedrock only. Required for Bedrock — Claude Code does not read it from ~/.aws. `aidlc config` writes this into settings.json when you choose Bedrock; set it here to override that for yourself. See docs/guide/01-getting-started.md § AWS Bedrock Setup.",
    "_comment_AWS_PROFILE": "Bedrock only. Set your AWS SSO/credential profile here (kept out of shared settings.json so it doesn't leak). Uncomment and set if you authenticate via a named profile.",
    "_comment_AWS_AIDLC_DEFAULT_SCOPE": "Pre-set default scope for /aidlc workflows. Valid: enterprise, feature, mvp, poc, bugfix, refactor, infra, security-patch, classic, workshop, express. Applies at workflow init only. See docs/guide/13-customization.md § Per-Project Default Scope.",
    "AWS_AIDLC_DEFAULT_SCOPE": "classic"
  },
  "model": "opus[1m]",
  "effortLevel": "xhigh"
